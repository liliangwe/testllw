<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.todo.mapper.TodoItemMapper">

    <resultMap id="BaseResultMap" type="com.example.todo.entity.TodoItemDO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="request_id" property="requestId"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.todo.entity.TodoItemDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todo_item (name, description, status, request_id, gmt_create, gmt_modified)
        VALUES (#{name}, #{description}, #{status}, #{requestId}, #{gmtCreate}, #{gmtModified})
    </insert>

    <select id="findByRequestId" resultMap="BaseResultMap">
        SELECT id, name, description, status, request_id, gmt_create, gmt_modified
        FROM todo_item
        WHERE request_id = #{requestId}
          AND request_id IS NOT NULL
        LIMIT 1
    </select>

</mapper>